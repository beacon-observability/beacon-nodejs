{
  "name": "@beacon-observability/nodejs",
  "version": "2.0.0",
  "description": "Beacon zero-code OpenTelemetry auto-instrumentation, profiling, and opt-in Security for Node.js",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": "./build/src/index.js",
    "./register": {
      "import": "./register.mjs",
      "require": "./build/src/register.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beacon-observability/beacon-nodejs.git",
    "directory": "packages/nodejs"
  },
  "homepage": "https://github.com/beacon-observability/beacon-nodejs/tree/main/packages/nodejs#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rimraf build/*",
    "compile": "tsc -p .",
    "compile:with-dependencies": "nx run-many -t compile -p @beacon-observability/nodejs",
    "prepublishOnly": "npm run compile",
    "test": "nyc --no-clean mocha --no-config --timeout 10000 --require ts-node/register/transpile-only 'test/**/*.test.js'",
    "version:update": "node ../../scripts/version-update.js",
    "watch": "tsc -w"
  },
  "keywords": [
    "opentelemetry",
    "observability",
    "nodejs",
    "auto-instrumentation",
    "zero-code",
    "profiling",
    "security"
  ],
  "author": "Beacon Observability Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "files": [
    "build/src/**/*.js",
    "build/src/**/*.js.map",
    "build/src/**/*.d.ts",
    "register.mjs"
  ],
  "dependencies": {
    "@beacon-observability/profiler-nodejs": "^2.0.0",
    "@beacon-observability/security-nodejs": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0"
  },
  "devDependencies": {
    "@types/node": "22.17.1"
  }
}
